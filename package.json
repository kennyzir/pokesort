{
  "name": "pokesort",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "python scripts/generate-icons.py",
    "refresh:pokemon-data": "node scripts/puzzle/refresh-pokemon-facts.mjs",
    "dev": "npm run build && npx serve dist",
    "build": "node scripts/build.mjs",
    "build:cloudflare": "node scripts/cloudflare-pages-build.mjs",
    "build:daily-calendar": "node scripts/puzzle/build-daily-calendar.mjs --attempts-per-rule-set 500",
    "validate:daily-calendar": "node scripts/puzzle/validate-daily-calendar.mjs",
    "report:daily-quality": "node scripts/puzzle/report-daily-quality.mjs",
    "prepare:private-daily-buffer": "node scripts/puzzle/prepare-private-daily-buffer.mjs",
    "prepare:daily-kv-upload": "node scripts/puzzle/daily-kv-upload.mjs",
    "publish:elapsed-history": "node scripts/puzzle/publish-elapsed-history.mjs",
    "stage:current-daily": "node scripts/puzzle/stage-current-daily.mjs",
    "verify:public-current": "node scripts/puzzle/verify-public-current.mjs",
    "monitor:daily-readiness": "node scripts/puzzle/monitor-daily-readiness.mjs",
    "test:daily-edge-api": "node scripts/puzzle/test-daily-edge-api.mjs",
    "check:release-security": "node scripts/puzzle/check-release-security.mjs",
    "test:release-security": "node scripts/puzzle/test-release-security.mjs",
    "test:r7-workflow": "node scripts/puzzle/test-r7-workflow-contract.mjs",
    "test:cloudflare-automation": "node scripts/puzzle/test-cloudflare-automation.mjs",
    "test:r7-release": "npm run test:daily-edge-api && npm run test:release-security && npm run test:r7-workflow && npm run test:cloudflare-automation && node scripts/puzzle/test-r7-release-rehearsal.mjs && npm run test:production-build-gate",
    "release:gate": "npm run check:release-security && npm run build",
    "validate:private-daily-buffer": "node scripts/puzzle/prepare-private-daily-buffer.mjs --validate-only",
    "test:r2-daily-quality": "node scripts/puzzle/test-r2-quality-buffer.mjs",
    "test:r2-year-stress": "node scripts/puzzle/test-r2-year-stress.mjs",
    "test:r2-capacity": "node scripts/puzzle/test-r2-capacity-repair.mjs",
    "check:elapsed-daily-bytes": "node scripts/puzzle/check-elapsed-daily-bytes.mjs",
    "export:public-daily-history": "node scripts/puzzle/export-elapsed-public-history.mjs",
    "test:public-daily-history": "node scripts/puzzle/test-public-daily-history.mjs",
    "test:public-capabilities": "node scripts/puzzle/test-public-capabilities.mjs",
    "test:r6-archive-seo": "node scripts/puzzle/test-r6-archive-seo.mjs",
    "test:r5-runtime-state": "node scripts/puzzle/test-r5-runtime-state.mjs",
    "build:infinite-pool": "node scripts/puzzle/build-infinite-pool.mjs",
    "validate:infinite-pool": "node scripts/puzzle/validate-infinite-pool.mjs",
    "validate:production-data": "node scripts/puzzle/production-data-gate.mjs",
    "test:puzzle-semantic": "node scripts/puzzle/test-semantic-verifier.mjs",
    "test:production-build-gate": "node scripts/puzzle/test-production-build-gate.mjs",
    "check:publication-leaks": "node scripts/puzzle/check-publication-leaks.mjs",
    "test:publication-leaks": "node scripts/puzzle/test-publication-leaks.mjs",
    "test:puzzle-data": "node scripts/puzzle/test-pokemon-facts.mjs && node scripts/puzzle/test-generator-solver.mjs && node scripts/puzzle/test-daily-calendar.mjs && node scripts/puzzle/validate-daily-calendar.mjs && npm run check:elapsed-daily-bytes && npm run test:r2-capacity && npm run test:r2-daily-quality && npm run test:r2-year-stress && npm run test:daily-edge-api && node scripts/puzzle/test-infinite-pool.mjs && node scripts/puzzle/validate-infinite-pool.mjs && npm run test:puzzle-semantic && node scripts/puzzle/test-r1-semantic-regressions.mjs && npm run test:production-build-gate",
    "test:puzzle-stress": "node scripts/puzzle/stress-generator.mjs 1000 200000",
    "test:pokelike-manifest": "node scripts/pokelike/test-manifest.mjs",
    "capture:pokelike-shadow": "node scripts/pokelike/capture-official.mjs",
    "mark:pokelike-published": "node scripts/pokelike/mark-published.mjs",
    "test:pokelike-capture": "node scripts/pokelike/test-capture.mjs",
    "test:pokelike-today": "node scripts/pokelike/test-today-render.mjs && node scripts/pokelike/test-today-runtime.mjs",
    "test:pokelike-analytics": "node scripts/pokelike/test-today-analytics.mjs",
    "generate:pokelike-drills": "node scripts/pokelike/generate-failure-drills.mjs",
    "test:pokelike-drills": "node scripts/pokelike/test-failure-drills.mjs && node scripts/pokelike/test-monitor-readiness.mjs",
    "monitor:pokelike-readiness": "node scripts/pokelike/monitor-readiness.mjs",
    "test:pokelike-shadow-workflow": "node scripts/pokelike/test-shadow-workflow.mjs",
    "test:seo-r1": "node scripts/seo/test-r1-static.mjs",
    "smoke:production": "node scripts/seo/production-smoke.mjs",
    "validate:pokelike-intent": "npm run build && node scripts/pokelike/validate-intent-routing.mjs",
    "test:static": "npm run test:publication-leaks && npm run check:publication-leaks && npm run test:public-daily-history && npm run test:public-capabilities && npm run test:puzzle-data && npm run test:pokelike-manifest && npm run test:pokelike-capture && npm run test:pokelike-today && npm run test:pokelike-analytics && npm run test:pokelike-drills && npm run test:pokelike-shadow-workflow && node scripts/validate.mjs && npm run test:seo-r1 && npm run test:r5-runtime-state && npm run test:r6-archive-seo && npm run test:r7-release && node scripts/regression.mjs",
    "test:runtime": "node scripts/runtime-test.mjs",
    "test": "npm run test:static && npm run test:runtime"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
